# ---------------------------------------------------------------------------
# Website Lusine — Umgebungsvariablen
#
# Diese Datei ist eine Vorlage. Kopiere sie nach .env.local und trage die
# echten Werte ein. .env.local gehoert NICHT ins Repository.
#
# Ohne jede dieser Variablen laeuft die Seite im Demo-Modus: Daten kommen
# aus den Seed-Dateien und Bilder aus /public. So laesst sich alles
# ansehen und testen, bevor die Konten angelegt sind.
#
# Es gibt keinen Zahlungsdienst: die Seite zeigt Preise an, verkauft aber
# nicht selbst. Anfragen laufen ueber das Kontaktformular.
# ---------------------------------------------------------------------------

# --- Supabase (Daten und Anmeldung) ---------------------------------------
# Projekt-Einstellungen -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig. Umgeht die Zugriffsregeln — niemals im Browser verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (Bildspeicher) -----------------------------------------
# R2 -> Bucket -> Einstellungen -> S3-API
R2_KONTO_ID=
R2_ZUGRIFFSSCHLUESSEL_ID=
R2_GEHEIMER_SCHLUESSEL=
R2_BUCKET=lusine-werke

# Oeffentliche Adresse des Cloudflare Workers, der die Bilder ausliefert.
# Beispiel: https://bilder.lusine-kunst.de
# Leer lassen fuer den lokalen Modus.
NEXT_PUBLIC_BILD_BASIS_URL=

# --- Resend (E-Mail) -------------------------------------------------------
RESEND_API_KEY=
# Absenderadresse, muss bei Resend verifiziert sein
EMAIL_ABSENDER="Lusine <atelier@lusine-kunst.de>"
# Hier gehen Anfragen und Kaufbenachrichtigungen ein
EMAIL_ATELIER=

# --- Allgemein -------------------------------------------------------------
# Vollstaendige Adresse der Seite, ohne abschliessenden Schraegstrich.
NEXT_PUBLIC_SEITEN_URL=http://localhost:3000
